      "wrapper": "import json,os,sys\nfrom pathlib import Path\nsys.path.insert(0,'/offline')\nfrom goodteam_os import skill_runtime_readiness as r\nroot=Path('/tmp/probe-env'); root.mkdir()\nenv=r.probe.clean_environment(root)\nruntime=r.probe.inspect_runtime('/runtime/bin/codex',root)\nwith r.probe.LoopbackFixture() as network:\n import urllib.request\n network_positive=network.marker in urllib.request.urlopen('http://127.0.0.1:'+str(network.server.server_port),timeout=2).read().decode()\n helper=['/usr/bin/python3','-I','/probe/tools/check.py','/probe',str(network.server.server_port),json.dumps(r.FILES)]\n command=helper if sys.argv[1]=='positive' else ['/runtime/bin/codex','sandbox','-c','sandbox_mode=\"read-only\"','--',*helper]\n result=r.probe.capture(command,cwd=Path('/probe/repo'),env=env,timeout=20)\n print(json.dumps({'uid':os.getuid(),'runtime':runtime,'network_positive':network_positive,'network_marker':network.marker,'command':command,'result':result}))\n",
